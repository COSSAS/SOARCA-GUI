{
  "type": "playbook",
  "spec_version": "cacao-2.0",
  "id": "playbook--f4a5b6c7-d8e9-4f0a-b1c2-d3e4f5a6b7c8",
  "name": "Incident response with host isolation",
  "description": "Two-step manual incident response. External variables (incident UUID, affected host, alert count) are supplied at trigger time. Step 1: analyst decides on host isolation. Step 2: analyst documents remediation.",
  "playbook_types": ["remediation"],
  "created_by": "identity--ac3c0258-7a81-46e7-a2ae-d34b6d06cc54",
  "created": "2026-05-28T10:00:00.000Z",
  "modified": "2026-05-28T10:00:00.000Z",
  "revoked": false,
  "valid_from": "2026-05-28T10:00:00.000Z",
  "valid_until": "2126-05-28T10:00:00.000Z",
  "priority": 1,
  "severity": 2,
  "impact": 2,
  "labels": ["soarca", "manual", "remediation"],
  "external_references": [
    {
      "name": "COSSAS",
      "description": "TNO COSSAS"
    }
  ],
  "playbook_variables": {
    "__incident_id__": {
      "type": "uuid",
      "description": "UUID of the incident in the ticketing system",
      "constant": false,
      "external": true
    },
    "__affected_host__": {
      "type": "string",
      "description": "Hostname or IP address of the affected system",
      "constant": false,
      "external": true
    },
    "__alert_count__": {
      "type": "integer",
      "description": "Number of alerts triggered by this incident",
      "constant": false,
      "external": true
    }
  },
  "workflow_start": "start--a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c50",
  "workflow_exception": "end--b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d60",
  "workflow": {
    "start--a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c50": {
      "type": "start",
      "name": "Start incident response",
      "on_completion": "action--c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e70"
    },
    "action--c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e70": {
      "type": "action",
      "name": "Confirm host isolation",
      "description": "Review incident context and decide whether to isolate the affected host from the network.",
      "step_variables": {
        "__isolate__": {
          "type": "bool",
          "description": "Set to true to isolate the host, false to monitor only",
          "constant": false,
          "external": false
        }
      },
      "commands": [
        {
          "type": "manual",
          "command": "Review the incident details and decide whether to isolate the affected host. Consider the alert count and potential business impact before proceeding."
        }
      ],
      "agent": "soarca-manual-capability--7b0e98db-fa93-42aa-8511-e871c65131b1",
      "targets": ["individual--9d1f6217-34d5-435c-b29a-6a1af6b664d9"],
      "out_args": ["__isolate__"],
      "on_completion": "action--d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80",
      "timeout": 300000
    },
    "action--d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f80": {
      "type": "action",
      "name": "Document remediation",
      "description": "Record all remediation actions taken and close the incident.",
      "step_variables": {
        "__remediation_notes__": {
          "type": "string",
          "description": "Summary of remediation actions taken",
          "constant": false,
          "external": false
        },
        "__incident_closed__": {
          "type": "bool",
          "description": "Set to true when the incident is fully resolved",
          "constant": false,
          "external": false
        }
      },
      "commands": [
        {
          "type": "manual",
          "command": "Document all remediation steps taken and confirm whether the incident is fully resolved."
        }
      ],
      "agent": "soarca-manual-capability--7b0e98db-fa93-42aa-8511-e871c65131b1",
      "targets": ["individual--9d1f6217-34d5-435c-b29a-6a1af6b664d9"],
      "out_args": ["__remediation_notes__", "__incident_closed__"],
      "on_completion": "end--b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d60",
      "timeout": 300000
    },
    "end--b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d60": {
      "type": "end",
      "name": "End incident response"
    }
  },
  "agent_definitions": {
    "soarca-manual-capability--7b0e98db-fa93-42aa-8511-e871c65131b1": {
      "type": "soarca-manual",
      "name": "soarca-manual",
      "description": "SOARCAs manual command handler"
    }
  },
  "target_definitions": {
    "individual--9d1f6217-34d5-435c-b29a-6a1af6b664d9": {
      "type": "individual",
      "name": "SOC Analyst",
      "description": "Security Operations Center analyst"
    }
  }
}
