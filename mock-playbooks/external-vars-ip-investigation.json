  "id": "playbook--3a7c9b2e-4f1d-4c8a-b5e6-9d0a2c4e7f81",
  "name": "Suspicious IP investigation",
  "description": "Investigate a suspicious IP address. External variables (IP and priority) are supplied at trigger time. An analyst manually triages and records the result.",
  "playbook_types": ["investigation"],
  "created_by": "identity--ac3c0258-7a81-46e7-a2ae-d34b6d06cc54",
  "created": "2026-05-28T10:00:00.000Z",
  "modified": "2026-05-28T10:00:00.000Z",
  "revoked": false,
  "valid_from": "2026-05-28T10:00:00.000Z",
  "valid_until": "2126-05-28T10:00:00.000Z",
  "priority": 1,
  "severity": 1,
  "impact": 1,
  "labels": ["soarca", "manual", "investigation"],
  "external_references": [
    {
      "name": "COSSAS",
      "description": "TNO COSSAS"
    }
  ],
  "playbook_variables": {
    "__target_ip__": {
      "type": "ipv4-addr",
      "description": "Suspicious IPv4 address to investigate",
      "constant": false,
      "external": true
    },
    "__priority__": {
      "type": "integer",
      "description": "Investigation priority level (1 = low, 10 = critical)",
      "constant": false,
      "external": true
    }
  },
  "workflow_start": "start--c1a2b3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
  "workflow_exception": "end--d2b3c4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
  "workflow": {
    "start--c1a2b3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d": {
      "type": "start",
      "name": "Start IP investigation",
      "on_completion": "action--e3c4d5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f"
    },
    "action--e3c4d5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f": {
      "type": "action",
      "name": "Analyst IP triage",
      "description": "Review the suspicious IP address and decide whether to escalate. Check threat intelligence feeds and firewall logs.",
      "step_variables": {
        "__escalate__": {
          "type": "bool",
          "description": "Set to true to escalate, false to close the investigation",
          "constant": false,
          "external": false
        },
        "__analyst_notes__": {
          "type": "string",
          "description": "Analyst notes about the IP address",
          "constant": false,
          "external": false
        }
      },
      "commands": [
        {
          "type": "manual",
          "command": "Review the suspicious IP and determine if escalation is needed. Check threat intelligence feeds and firewall logs for activity from this address."
        }
      ],
      "agent": "soarca-manual-capability--7b0e98db-fa93-42aa-8511-e871c65131b1",
      "targets": ["individual--9d1f6217-34d5-435c-b29a-6a1af6b664d9"],
      "out_args": ["__escalate__", "__analyst_notes__"],
      "on_completion": "end--d2b3c4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
      "timeout": 300000
    },
    "end--d2b3c4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e": {
      "type": "end",
      "name": "End IP investigation"
    }
  },
