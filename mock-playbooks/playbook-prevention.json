{
  "type": "playbook",
  "spec_version": "cacao-2.0",
  "id": "playbook--4ba7c839-5cb8-6d69-3f50-c839e4ba7c83",
  "name": "Zero-Trust Network Access Prevention",
  "description": "Prevent unauthorized network access through zero-trust policy configuration and security hardening",
  "playbook_types": ["prevention"],
  "playbook_activities": ["scan-vulnerabilities", "configure-systems"],
  "playbook_processing_summary": {
    "manual_playbook": false,
    "external_playbooks": false,
    "parallel_processing": false,
    "if_logic": false,
    "while_logic": true,
    "switch_logic": false,
    "temporal_logic": true,
    "data_markings": false,
    "digital_signatures": false
  },
  "created_by": "identity--00000000-0000-0000-0000-000000000004",
  "created": "2025-01-23T11:00:00.000Z",
  "modified": "2025-01-23T11:00:00.000Z",
  "valid_from": "2025-01-23T11:00:00.000Z",
  "priority": 70,
  "severity": 65,
  "impact": 50,
  "playbook_variables": {
    "__scan_environment__": {
      "type": "string",
      "description": "Target environment to scan for vulnerabilities",
      "value": "production",
      "external": true
    },
    "__policy_version__": {
      "type": "string",
      "description": "Zero-trust policy version to deploy",
      "external": true
    },
    "__compliance_check_id__": {
      "type": "string",
      "description": "Compliance check identifier",
      "external": true
    }
  },
  "workflow_start": "start--5cb8d94a-6dc9-7e7a-4061-d94ac5cb8d94",
  "workflow": {
    "start--5cb8d94a-6dc9-7e7a-4061-d94ac5cb8d94": {
      "type": "start",
      "name": "Start Prevention Workflow",
      "on_completion": "action--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5"
    },
    "action--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5": {
      "type": "action",
      "name": "Scan for Vulnerabilities",
      "description": "Comprehensive vulnerability scan of target environment",
      "playbook_activity": "scan-vulnerabilities",
      "commands": [
        {
          "type": "http-api",
          "command": "POST /api/vuln-scanner/start?environment=__scan_environment__:value HTTP/1.1",
          "playbook_activity": "scan-vulnerabilities"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "targets": ["security-category--7edafb6c-8feb-a09c-6283-fb6ce7edafb6"],
      "on_completion": "while-condition--7edafb6c-8feb-a09c-6283-fb6ce7edafb6",
      "timeout": 300000
    },
    "while-condition--7edafb6c-8feb-a09c-6283-fb6ce7edafb6": {
      "type": "while-condition",
      "name": "Process Identified Vulnerabilities",
      "description": "Loop through all identified vulnerabilities and remediate",
      "condition": "__vulnerabilities_remaining__:value > 0",
      "on_true": "action--8feafdc7-90fc-b1ad-7394-0fcf8feafd7c",
      "on_completion": "action--90fbae8e-a110-c2be-8540-10d0a090fbae"
    },
    "action--8feafdc7-90fc-b1ad-7394-0fcf8feafd7c": {
      "type": "action",
      "name": "Get Next Vulnerability",
      "description": "Retrieve next vulnerability from scan results",
      "playbook_activity": "scan-vulnerabilities",
      "commands": [
        {
          "type": "http-api",
          "command": "GET /api/vuln-scanner/next-vuln HTTP/1.1",
          "playbook_activity": "scan-vulnerabilities"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "targets": ["security-category--7edafb6c-8feb-a09c-6283-fb6ce7edafb6"],
      "on_completion": "end--91fcbf9f-b221-d3cf-9651-21e1b91fcbf9"
    },
    "end--91fcbf9f-b221-d3cf-9651-21e1b91fcbf9": {
      "type": "end",
      "name": "End Vulnerability Processing Loop"
    },
    "action--90fbae8e-a110-c2be-8540-10d0a090fbae": {
      "type": "action",
      "name": "Configure Zero-Trust Policies",
      "description": "Deploy zero-trust network access policies",
      "playbook_activity": "configure-systems",
      "commands": [
        {
          "type": "http-api",
          "command": "POST /api/policy/deploy?version=__policy_version__:value HTTP/1.1",
          "playbook_activity": "configure-systems"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "targets": ["security-category--a221ca0f-c332-e4d0-a762-32f2aa221ca0"],
      "on_completion": "action--b332db10-d443-f5e1-b873-43a3bb332db1",
      "timeout": 60000
    },
    "action--b332db10-d443-f5e1-b873-43a3bb332db1": {
      "type": "action",
      "name": "Harden System Configurations",
      "description": "Apply security hardening baselines and best practices",
      "playbook_activity": "configure-systems",
      "commands": [
        {
          "type": "bash",
          "command": "ansible-playbook /playbooks/hardening-baseline.yml -i /inventory/production.ini",
          "playbook_activity": "configure-systems"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "on_completion": "action--c443ec21-e554-a6f2-ca84-54b4cc443ec2",
      "timeout": 180000
    },
    "action--c443ec21-e554-a6f2-ca84-54b4cc443ec2": {
      "type": "action",
      "name": "Deploy Security Baselines",
      "description": "Deploy approved security configurations to all systems",
      "playbook_activity": "configure-systems",
      "commands": [
        {
          "type": "http-api",
          "command": "POST /api/config/deploy-baseline HTTP/1.1",
          "playbook_activity": "configure-systems"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "targets": ["security-category--a221ca0f-c332-e4d0-a762-32f2aa221ca0"],
      "on_completion": "action--d554fd32-f665-b703-db95-65c5dd554fd3",
      "timeout": 120000
    },
    "action--d554fd32-f665-b703-db95-65c5dd554fd3": {
      "type": "action",
      "name": "Verify Compliance",
      "description": "Run compliance checks to ensure prevention controls are in place",
      "playbook_activity": "configure-systems",
      "commands": [
        {
          "type": "http-api",
          "command": "POST /api/compliance/verify?check-id=__compliance_check_id__:value HTTP/1.1",
          "playbook_activity": "configure-systems"
        }
      ],
      "agent": "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5",
      "targets": ["security-category--a221ca0f-c332-e4d0-a762-32f2aa221ca0"],
      "on_completion": "action--e665ae43-a776-c814-eca6-76d6ee665ae4",
      "timeout": 90000
    },
    "action--e665ae43-a776-c814-eca6-76d6ee665ae4": {
      "type": "action",
      "name": "Document Prevention Deployment",
      "description": "Create audit trail and documentation of prevention controls deployed",
      "playbook_activity": "configure-systems",
      "commands": [
        {
          "type": "manual",
          "command": "Document deployment of zero-trust policy version __policy_version__:value and security baselines in compliance system"
        }
      ],
      "agent": "individual--e665ae43-a776-c814-eca6-76d6ee665ae4",
      "on_completion": "end--f776bf54-b887-d925-fdb7-87e7ff776bf5"
    },
    "end--f776bf54-b887-d925-fdb7-87e7ff776bf5": {
      "type": "end",
      "name": "Prevention Deployment Complete"
    }
  },
  "agent_definitions": {
    "security-category--6dc9ea5b-7eda-8f8b-5172-ea5bd6dc9ea5": {
      "type": "security-category",
      "name": "Security Automation Platform",
      "description": "Centralized platform for security automation and compliance",
      "category": ["orchestrator", "analytics"]
    },
    "individual--e665ae43-a776-c814-eca6-76d6ee665ae4": {
      "type": "individual",
      "name": "Compliance Officer",
      "description": "Officer responsible for compliance documentation and verification"
    }
  },
  "target_definitions": {
    "security-category--7edafb6c-8feb-a09c-6283-fb6ce7edafb6": {
      "type": "security-category",
      "name": "Vulnerability Scanner",
      "description": "Automated vulnerability scanning system",
      "category": ["analytics"]
    },
    "security-category--a221ca0f-c332-e4d0-a762-32f2aa221ca0": {
      "type": "security-category",
      "name": "Policy Management System",
      "description": "Centralized policy management and deployment platform",
      "category": ["orchestrator"]
    }
  }
}
